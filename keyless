--------------------------------------------------
-- LOADING ANIMATION
--------------------------------------------------

local startTime = os.clock()

while true do
	local progress = math.clamp((os.clock() - startTime) / LOAD_DURATION, 0, 1)
	local value = math.floor(progress * 100)

	percent.Text = value .. "%"
	bar.Size = UDim2.new(progress, 0, 1, 0)

	if value < 25 then
		status.Text = "Initializing system..."
	elseif value < 50 then
		status.Text = "Preparing interface..."
	elseif value < 75 then
		status.Text = "Loading visual components..."
	elseif value < 100 then
		status.Text = "Almost ready..."
	else
		break
	end

	task.wait(0.03)
end

percent.Text = "100%"
bar.Size = UDim2.new(1, 0, 1, 0)
status.Text = "Load complete!"
badge.Text = "READY"
badge.TextColor3 = COLORS.green

task.wait(0.8)

