--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function addCorner(obj, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = obj
end

local function addGradient(obj)
	local g = Instance.new("UIGradient")
	-- FIX: ColorSequence needs keypoints, not a plain list of Color3
	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, COLORS.gold),
		ColorSequenceKeypoint.new(0.33, COLORS.pink),
		ColorSequenceKeypoint.new(0.66, COLORS.purple),
		ColorSequenceKeypoint.new(1, COLORS.gold),
	})
	g.Offset = Vector2.new(-1, 0)
	g.Parent = obj

	TweenService:Create(
		g,
		TweenInfo.new(4, Enum.EasingStyle.Linear, Enum.EasingDirection.In, -1),
		{ Offset = Vector2.new(1, 0) }
	):Play()

	return g
end

local function addBorder(obj)
	local s = Instance.new("UIStroke")
	s.Thickness = 2
	s.Color = COLORS.white
	s.Parent = obj
	addGradient(s)
end

local function makeLabel(parent, text, size, pos, fontSize)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.Size = size
	l.Position = pos
	l.Font = Enum.Font.GothamBold
	l.TextSize = fontSize
	l.TextColor3 = COLORS.white
	l.Parent = parent
	return l
end

local function makeDraggable(handle, frame)
	local dragging = false
	local startInput, startPos

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			startInput = input.Position
			startPos = frame.Position

			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					conn:Disconnect()
				end
			end)
		end
	end)

	local moveConn = UIS.InputChanged:Connect(function(input)
		if dragging and (
			input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			) then
			local delta = input.Position - startInput
			frame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)

	-- FIX: don't leak the global connection when the GUI is destroyed
	frame.Destroying:Connect(function()
		moveConn:Disconnect()
	end)
end

